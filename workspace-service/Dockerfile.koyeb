# Koyeb-Variante: Koyeb baut mit Repository-Root als Kontext,
# daher muessen COPY-Pfade root-relativ sein. Das Original-Dockerfile
# behaelt den lokalen docker-compose-Kontext bei ./workspace-service.
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates

WORKDIR /app
COPY workspace-service/package.json ./
RUN npm install --omit=dev
COPY workspace-service/src ./src

ENV NODE_ENV=production
EXPOSE 8787
CMD ["npm", "start"]
