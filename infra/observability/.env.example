# Copy to .env and keep it out of Git.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_SECRET
# Must exactly match the application METRICS_TOKEN.
METRICS_TOKEN=REPLACE_WITH_RANDOM_SECRET
# Hostname:port reachable from the Prometheus container.
APP_METRICS_TARGET=host.docker.internal:3000
GRAFANA_ROOT_URL=http://localhost:3000
FARO_INGEST_KEY=REPLACE_WITH_RANDOM_INGEST_KEY
APP_PUBLIC_ORIGIN=https://app.example.com
