# Kernbetrieb
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://control.example.com
APP_ALLOWED_ORIGINS=https://control.example.com,https://app.example.com
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
METRICS_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cybersarah
JWT_SECRET=USE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# Optionaler Manus/OAuth-Login zusätzlich zum lokalen Account-System
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
# Öffentliche Koyeb-URL für Mobile-Builds, z.B. https://<service>.koyeb.app
EXPO_PUBLIC_API_BASE_URL=

# On-Server LLM (verpflichtend, wenn Provider "managed" verwendet wird)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Lokale bzw. Open-Source-Provider
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_OLLAMA_MODEL=qwen2.5-coder:7b
AI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
AI_LMSTUDIO_MODEL=local-model
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=local-model

# Weitere serverseitige Provider (jeweils nur konfigurieren, wenn im Control Center genutzt)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openrouter/free
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-20b
AI_TOGETHER_API_KEY=
AI_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_HUGGINGFACE_API_KEY=
AI_HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1:fastest

# Stripe: im Produktivbetrieb live, lokal mit Stripe CLI test möglich.
# STRIPE_MODE=live verlangt sk_live_; STRIPE_MODE=test verlangt sk_test_.
STRIPE_MODE=live
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_SECRET
STRIPE_PRICE_ID=price_REPLACE_WITH_RECURRING_PRODUCTION_PRICE
# Bevorzugte autonome Auflösung: stabiler Lookup-Key aus dem Stripe-Preis.
STRIPE_PRICE_LOOKUP_KEY=cybersarah-monthly
# Fallback: Wenn STRIPE_PRICE_ID fehlt oder Stripe ihn ablehnt, loest der Server
# den Preis automatisch über Lookup-Key oder dieses Produkt auf (Monats-Intervall bevorzugt).
# STRIPE_PRODUCT_MONATLICH=prod_REPLACE_WITH_MONTHLY_SUBSCRIPTION_PRODUCT
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_PRODUCTION_WEBHOOK_SECRET

# Sprint 110 - Zentrale Betriebsansicht (alle optional, ehrliche Nicht-Konfiguriert-Zustaende):
# Render-Deploy-Status via Render-API (ohne Key: Check meldet 'unknown' mit Hinweis)
RENDER_API_KEY=
# Optional: zielt den geprueften Service gezielt an (Default: erster Web-Service)
RENDER_SERVICE_ID=
# Admin-Alarm bei Stufenwechsel zu kritisch (Discord-Webhook; ohne Key nur Dashboard/Log)
DISCORD_WEBHOOK_URL=
# Optional: Repo des Uptime-Waechters (Default: niknight1403/CyberSarah-Control-Center)
OPS_UPTIME_REPO=

# Sprint 133 — Autonomer Engineering-Optimizer-Loop (startet mit dem Server).
# OPTIMIZER_LOOP_ENABLED=false deaktiviert ihn; Intervall in Minuten (30-10080, Default 360).
OPTIMIZER_LOOP_ENABLED=true
OPTIMIZER_LOOP_INTERVAL_MIN=360

# ==========================================
# PRODUKTIONS-KONFIGURATION (Struktur-Referenz)
# Echte Werte NUR in die lokale .env — niemals committen!
# Siehe auch: /docs/DEPLOYMENT.md
# ==========================================

# --- Server & Umgebung ---
NODE_ENV=production
LIVE_MODE=true
SIMULATION_MODE=false
SERVER_IP=<deine-server-ip>
ALLOWED_ORIGINS=https://deine-domain.de,https://www.deine-domain.de,http://<deine-server-ip>
PRODUCT_DOMAIN=https://deine-domain.de

# --- Stripe (LIVE) ---
STRIPE_SECRET_KEY=sk_live_***
STRIPE_PUBLISHABLE_KEY=pk_live_***
STRIPE_WEBHOOK_SECRET=whsec_***
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxx
STRIPE_PRODUCT_EINMALZAHLUNG=prod_xxx
STRIPE_PRODUCT_MONATLICH=prod_xxx

# --- Stripe (TEST) ---
STRIPE_TEST_SECRET_KEY=sk_test_***
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_***
STRIPE_TEST_REST_KEY_1=***
STRIPE_TEST_REST_KEY_2=***

# --- KI-Provider ---
OPENAI_API_KEY=sk-***
OPENAI_BACKUP_KEY=sk-***
GEMINI_API_KEY=***
GEMINI_BACKUP_KEY=***

# --- Digistore24 ---
DIGISTORE24_API_KEY=***
DIGISTORE24_USERNAME=<ds24-username>
DIGISTORE24_VENDOR_ID=<vendor-id>
DIGISTORE24_IPN_SECRET=

# --- Messaging & Social ---
TELEGRAM_BOT_TOKEN=<bot-token>
TIKTOK_CLIENT_KEY=<client-key>
TIKTOK_CLIENT_SECRET=<client-secret>

# --- Auth & Mail ---
ADMIN_EMAIL=<admin@example.de>
RESEND_API_KEY=re_***
API_AUTH_TOKEN=<random-token>
VITE_API_AUTH_TOKEN=<random-token>
DEPLOY_TOKEN=<random-token>

# --- Alternative externe DB (Neon) — bei Bedarf aktivieren ---
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sprint 154/155: Provider-Admin & autonomes Key-Management -----------------
# Key-Pools: ENV-Keys duerfen kommagetrennte Pools enthalten (key1,key2,...);
# bei invalid/expired/revoked/rate_limited rotiert das System autonom weiter.
# SECRET_MANAGER_TYPE=render            # render | vault | aws | gcp (optional)
# SECRET_MANAGER_API_TOKEN=...          # Render-API-Token fuer Auto-Refetch
# SECRET_MANAGER_RENDER_SERVICE=...     # Render-Service-ID (srv-...) oder Name
# PROVIDER_ROTATION_WEBHOOK_SECRET=...  # autorisierter Rotations-Webhook (x-rotation-secret)
# PROVIDER_KEY_ENCRYPTION_SECRET=...    # optional: eigenes Secret fuer die AES-256-GCM-Key-Ablage
