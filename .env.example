# Kernbetrieb
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://control.example.com
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/cybersarah
JWT_SECRET=USE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# Optionaler Manus/OAuth-Login zusätzlich zum lokalen Account-System
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# On-Server LLM (verpflichtend, wenn Provider "managed" verwendet wird)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Lokale bzw. Open-Source-Provider
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AI_OLLAMA_MODEL=qwen2.5-coder:7b
AI_LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
AI_LMSTUDIO_MODEL=local-model
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=local-model

# Weitere serverseitige Provider (jeweils nur konfigurieren, wenn im Control Center genutzt)
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openrouter/free
AI_GROQ_API_KEY=
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_TOGETHER_API_KEY=
AI_TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-5-haiku-latest
AI_HUGGINGFACE_API_KEY=
AI_HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1:fastest

# Stripe: ausschließlich Live-Werte. STRIPE_SECRET_KEY muss mit sk_live_ beginnen.
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_SECRET
STRIPE_PRICE_ID=price_REPLACE_WITH_RECURRING_PRODUCTION_PRICE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_PRODUCTION_WEBHOOK_SECRET
