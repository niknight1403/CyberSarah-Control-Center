[Unit]
Description=CyberSarah Control Center
Documentation=https://github.com/niknight1403/CyberSarah-Control-Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cybersarah
Group=cybersarah
WorkingDirectory=/opt/cybersarah-control-center
EnvironmentFile=/opt/cybersarah-control-center/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

# Basic service hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
UMask=027

[Install]
WantedBy=multi-user.target
